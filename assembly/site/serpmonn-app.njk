  </main>
  {% include "partials/metrika-main.njk" %}
  <script src="/frontend/scripts/direct-conversion-goals.js?v=13" defer></script>
  <script type="module" src="/frontend/scripts/menu-loader.js" defer></script>
  <script>
    (function () {
      var shots = document.querySelectorAll('.shot');
      if (!shots.length) return;
      if (!('IntersectionObserver' in window)) {
        shots.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      shots.forEach(function (el, i) {
        el.style.transitionDelay = (i * 70) + 'ms';
        io.observe(el);
      });
    })();
  </script>
