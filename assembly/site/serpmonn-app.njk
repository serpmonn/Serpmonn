---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{% if locale == 'ru' %}/frontend/app/serpmonn-app.html{% else %}/frontend/{{ locale }}/app/serpmonn-app.html{% endif %}"
eleventyComputed:
  dir: "{% if rtlLocales.indexOf(locale) != -1 %}rtl{% else %}ltr{% endif %}"
  title: "{{ serpmonnAppTranslations[locale].app.pageTitle }}"
  description: "{{ serpmonnAppTranslations[locale].app.description }}"
  canonical: "{% if locale == 'ru' %}{{ site.baseUrl }}/frontend/app/serpmonn-app.html{% else %}{{ site.baseUrl }}/frontend/{{ locale }}/app/serpmonn-app.html{% endif %}"
  installGuideHref: "{% if locale == 'ru' %}/frontend/knowledge-base/articles/serpmonn-install-guide.html{% else %}/frontend/{{ locale }}/knowledge-base/articles/serpmonn-install-guide.html{% endif %}"
---
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Language" content="{{ locale }}">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:title" content="{{ serpmonnAppTranslations[locale].app.ogTitle }}">
  <meta property="og:description" content="{{ serpmonnAppTranslations[locale].app.ogDescription }}">
  <meta property="og:image" content="{{ site.baseUrl }}/frontend/images/Banner_Serpmonn.png">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="website">
  {% for loc in locales %}
    {% if loc == 'ru' %}
      <link rel="alternate" href="{{ site.baseUrl }}/frontend/app/serpmonn-app.html" hreflang="{{ loc }}" />
    {% else %}
      <link rel="alternate" href="{{ site.baseUrl }}/frontend/{{ loc }}/app/serpmonn-app.html" hreflang="{{ loc }}" />
    {% endif %}
  {% endfor %}
  <link rel="alternate" href="{{ site.baseUrl }}/frontend/app/serpmonn-app.html" hreflang="x-default" />
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/frontend/styles/accessibility.css">
  <link rel="stylesheet" href="/frontend/styles/menu.css?v=app-landing2">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f3f5f8;
      --bg-elev: #ffffff;
      --text: #1a1f2a;
      --muted: #5b6575;
      --accent: #d92c2c;
      --accent-hover: #b82424;
      --line: rgba(26, 31, 42, 0.1);
      --radius: 14px;
      --font: "Manrope", system-ui, sans-serif;
      --display: "Source Serif 4", Georgia, serif;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      min-height: 100%;
      background:
        radial-gradient(1000px 520px at 8% -8%, rgba(217, 44, 44, 0.1), transparent 55%),
        radial-gradient(800px 420px at 92% 0%, rgba(40, 90, 160, 0.06), transparent 50%),
        linear-gradient(180deg, #fafbfc 0%, var(--bg) 45%, #eef1f5 100%);
      color: var(--text);
      font-family: var(--font);
      line-height: 1.5;
    }
    a { color: inherit; }
    .wrap {
      width: min(1080px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 5.5rem 0 4rem;
    }
    .hero {
      display: grid;
      gap: 1.5rem;
      max-width: 40rem;
      margin-bottom: 2.5rem;
    }
    .brand {
      font-family: var(--display);
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin: 0;
    }
    .lead {
      margin: 0;
      color: var(--muted);
      font-size: 1.1rem;
      max-width: 34rem;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
      align-items: center;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.35rem;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      border: none;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .btn-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }
    .btn-secondary {
      color: var(--muted);
      font-size: 0.95rem;
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 600;
    }
    .btn-secondary:hover { color: var(--text); }
    .meta {
      margin: 0;
      color: var(--muted);
      font-size: 0.88rem;
    }
    .features {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem 1.25rem;
      margin: 0 0 2.5rem;
      padding: 0;
      list-style: none;
    }
    .features li {
      font-weight: 600;
      font-size: 0.98rem;
      color: var(--text);
    }
    .features li:not(:last-child)::after {
      content: "";
    }
    .shots {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }
    .shots figure {
      margin: 0;
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 12px 28px rgba(26, 31, 42, 0.08);
    }
    .shots img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 9 / 16;
      object-fit: contain;
      object-position: center;
      background: #eef0f3;
    }
    .shots figcaption {
      padding: 0.65rem 0.8rem 0.85rem;
      color: var(--muted);
      font-size: 0.82rem;
    }
    .note {
      margin-top: 2rem;
      color: var(--muted);
      font-size: 0.9rem;
      max-width: 40rem;
    }
    .note a {
      color: var(--text);
      font-weight: 600;
    }
    .zbt {
      margin-top: 2.75rem;
      padding: 1.35rem 1.4rem 1.45rem;
      max-width: 40rem;
      background: var(--bg-elev);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 10px 24px rgba(26, 31, 42, 0.06);
    }
    .zbt h2 {
      margin: 0 0 0.65rem;
      font-family: var(--display);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.25;
    }
    .zbt p {
      margin: 0 0 0.75rem;
      color: var(--muted);
      font-size: 0.98rem;
    }
    .zbt .steps {
      margin: 0 0 1rem;
      padding-left: 1.15rem;
      color: var(--text);
      font-size: 0.95rem;
    }
    .zbt .steps li { margin: 0.25rem 0; }
    .zbt .cta-row { margin-bottom: 0.65rem; }
    .zbt .meta { margin: 0.75rem 0 0; }
    .zbt-form {
      display: grid;
      gap: 0.65rem;
      margin: 0 0 0.85rem;
    }
    .zbt-form label {
      font-weight: 600;
      font-size: 0.92rem;
    }
    .zbt-form input[type="email"] {
      width: 100%;
      max-width: 28rem;
      padding: 0.75rem 0.9rem;
      border: 1px solid var(--line);
      border-radius: 10px;
      font: inherit;
      background: #fff;
      color: var(--text);
    }
    .zbt-form input[type="email"]:focus {
      outline: 2px solid rgba(217, 44, 44, 0.35);
      outline-offset: 1px;
    }
    .zbt-form .btn-primary {
      justify-self: start;
      cursor: pointer;
      font: inherit;
    }
    .zbt-form .form-error {
      margin: 0;
      color: var(--accent);
      font-size: 0.88rem;
      display: none;
    }
    .zbt-form .form-error.is-visible { display: block; }
    .zbt-form .form-ok {
      margin: 0;
      color: #1f7a3f;
      font-size: 0.88rem;
      display: none;
    }
    .zbt-form .form-ok.is-visible { display: block; }
    .zbt-form .btn-primary:disabled {
      opacity: 0.65;
      cursor: wait;
      transform: none;
    }
    @media (max-width: 1100px) {
      .shots { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 800px) {
      .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 420px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .btn-primary { transition: none; }
      .btn-primary:hover { transform: none; }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <section class="hero" aria-labelledby="app-title">
      <h1 id="app-title" class="brand">Serpmonn</h1>
      <p class="lead">{{ serpmonnAppTranslations[locale].app.lead }}</p>
      <div class="cta-row">
        <a class="btn-primary" id="cta-apk" href="/frontend/downloads/Serpmonn-1.2.8.apk" download="Serpmonn-1.2.8.apk">
          {{ serpmonnAppTranslations[locale].app.ctaApk }}
        </a>
        <a class="btn-secondary" id="cta-rustore" href="https://www.rustore.ru/catalog/app/ru.serpmonn" target="_blank" rel="noopener">{{ serpmonnAppTranslations[locale].app.ctaRustore }}</a>
      </div>
      <p class="meta">{{ serpmonnAppTranslations[locale].app.meta }}</p>
    </section>

    <ul class="features" aria-label="{{ serpmonnAppTranslations[locale].app.featuresAria }}">
      {% for item in serpmonnAppTranslations[locale].app.features %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>

        <section class="shots" aria-label="{{ serpmonnAppTranslations[locale].app.shotsAria }}">
      <figure>
        <img src="/frontend/downloads/rustore-screenshots/05-search.png?v=128" alt="{{ serpmonnAppTranslations[locale].app.altSearch }}" width="360" height="640" loading="eager">
        <figcaption>{{ serpmonnAppTranslations[locale].app.capSearch }}</figcaption>
      </figure>
      <figure>
        <img src="/frontend/downloads/rustore-screenshots/01-profile-feed.png?v=128" alt="{{ serpmonnAppTranslations[locale].app.altFeed }}" width="360" height="640" loading="lazy">
        <figcaption>{{ serpmonnAppTranslations[locale].app.capFeed }}</figcaption>
      </figure>
      <figure>
        <img src="/frontend/downloads/rustore-screenshots/04-tools.png?v=128" alt="{{ serpmonnAppTranslations[locale].app.altTools }}" width="360" height="640" loading="lazy">
        <figcaption>{{ serpmonnAppTranslations[locale].app.capTools }}</figcaption>
      </figure>
      <figure>
        <img src="/frontend/downloads/rustore-screenshots/03-games.png?v=128" alt="{{ serpmonnAppTranslations[locale].app.altGames }}" width="360" height="640" loading="lazy">
        <figcaption>{{ serpmonnAppTranslations[locale].app.capGames }}</figcaption>
      </figure>
      <figure>
        <img src="/frontend/downloads/rustore-screenshots/06-profile.png?v=128" alt="{{ serpmonnAppTranslations[locale].app.altProfile }}" width="360" height="640" loading="lazy">
        <figcaption>{{ serpmonnAppTranslations[locale].app.capProfile }}</figcaption>
      </figure>
    </section>

    <section class="zbt" aria-labelledby="zbt-title">
      <h2 id="zbt-title">{{ serpmonnAppTranslations[locale].app.zbtTitle }}</h2>
      <p>{{ serpmonnAppTranslations[locale].app.zbtLead }}</p>
      <ol class="steps">
        <li>{{ serpmonnAppTranslations[locale].app.zbtStep1 }}</li>
        <li>{{ serpmonnAppTranslations[locale].app.zbtStep2 }}</li>
        <li>{{ serpmonnAppTranslations[locale].app.zbtStep3 }}</li>
      </ol>
      <form class="zbt-form" id="zbt-apply-form" novalidate>
        <label for="zbt-email">{{ serpmonnAppTranslations[locale].app.zbtLabel }}</label>
        <input id="zbt-email" name="email" type="email" required autocomplete="email" placeholder="name@example.com" inputmode="email">
        <p class="form-error" id="zbt-form-error" role="alert"></p>
        <p class="form-ok" id="zbt-form-ok" role="status"></p>
        <button class="btn-primary" type="submit" id="zbt-submit">{{ serpmonnAppTranslations[locale].app.zbtCta }}</button>
      </form>
      <p class="meta">{{ serpmonnAppTranslations[locale].app.zbtMeta }}</p>
      <p class="meta" style="margin-top:0.45rem">
        {{ serpmonnAppTranslations[locale].app.zbtAlready }}
        <a class="btn-secondary" id="cta-play-zbt" href="https://play.google.com/apps/testing/ru.serpmonn" target="_blank" rel="noopener">{{ serpmonnAppTranslations[locale].app.zbtConfirm }}</a>
      </p>
    </section>
  </main>
  {% include "partials/metrika-main.njk" %}
  <script src="/frontend/scripts/direct-conversion-goals.js?v=1" defer></script>
  <script type="module" src="/frontend/scripts/menu-loader.js" defer></script>
  <script>
    (function () {
      var form = document.getElementById('zbt-apply-form');
      var input = document.getElementById('zbt-email');
      var err = document.getElementById('zbt-form-error');
      var ok = document.getElementById('zbt-form-ok');
      var btn = document.getElementById('zbt-submit');
      if (!form || !input) return;
      var errInvalid = {{ serpmonnAppTranslations[locale].app.zbtError | dump | safe }};
      var errNetwork = {{ serpmonnAppTranslations[locale].app.zbtNetworkError | dump | safe }};

      function showError(msg) {
        if (ok) { ok.textContent = ''; ok.classList.remove('is-visible'); }
        if (err) { err.textContent = msg || errInvalid; err.classList.add('is-visible'); }
      }
      function showOk(msg) {
        if (err) { err.textContent = ''; err.classList.remove('is-visible'); }
        if (ok) { ok.textContent = msg; ok.classList.add('is-visible'); }
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var email = (input.value || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError(errInvalid);
          input.focus();
          return;
        }
        if (btn) btn.disabled = true;
        try {
          var res = await fetch('/api/play-testers/apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ email: email, source: 'serpmonn-app' })
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok || !data.success) {
            showError(data.message || errNetwork);
            return;
          }
          showOk(data.message || '');
          form.reset();
        } catch (ex) {
          showError(errNetwork);
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    })();
  </script>
</body>
</html>
