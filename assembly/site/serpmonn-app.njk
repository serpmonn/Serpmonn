---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{% if locale == 'ru' %}/frontend/app/serpmonn-app.html{% else %}/frontend/{{ locale }}/app/serpmonn-app.html{% endif %}"
eleventyComputed:
  dir: "{% if rtlLocales.indexOf(locale) != -1 %}rtl{% else %}ltr{% endif %}"
  title: "{{ serpmonnAppTranslations[locale].app.pageTitle }}"
  description: "{{ serpmonnAppTranslations[locale].app.description }}"
  canonical: "{% if locale == 'ru' %}{{ site.baseUrl }}/frontend/app/serpmonn-app.html{% else %}{{ site.baseUrl }}/frontend/{{ locale }}/app/serpmonn-app.html{% endif %}"
  installGuideHref: "{% if locale == 'ru' %}/frontend/knowledge-base/articles/serpmonn-install-guide.html{% else %}/frontend/{{ locale }}/knowledge-base/articles/serpmonn-install-guide.html{% endif %}"
---
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Language" content="{{ locale }}">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:title" content="{{ serpmonnAppTranslations[locale].app.ogTitle }}">
  <meta property="og:description" content="{{ serpmonnAppTranslations[locale].app.ogDescription }}">
  <meta property="og:image" content="{{ site.baseUrl }}/frontend/images/stores/serpmonn-app-og.png?v=13">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ serpmonnAppTranslations[locale].app.ogTitle }}">
  <meta name="twitter:description" content="{{ serpmonnAppTranslations[locale].app.ogDescription }}">
  <meta name="twitter:image" content="{{ site.baseUrl }}/frontend/images/stores/serpmonn-app-og.png?v=13">
  {% for loc in locales %}
    {% if loc == 'ru' %}
      <link rel="alternate" href="{{ site.baseUrl }}/frontend/app/serpmonn-app.html" hreflang="{{ loc }}" />
    {% else %}
      <link rel="alternate" href="{{ site.baseUrl }}/frontend/{{ loc }}/app/serpmonn-app.html" hreflang="{{ loc }}" />
    {% endif %}
  {% endfor %}
  <link rel="alternate" href="{{ site.baseUrl }}/frontend/app/serpmonn-app.html" hreflang="x-default" />
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/frontend/styles/accessibility.css">
  <link rel="stylesheet" href="/frontend/styles/menu.css?v=app-landing3">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #eef1f5;
      --text: #141820;
      --muted: #5a6472;
      --accent: #d92c2c;
      --font: "Manrope", system-ui, sans-serif;
      --display: "Source Serif 4", Georgia, serif;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --page-bg:
        radial-gradient(900px 520px at 12% -10%, rgba(217, 44, 44, 0.16), transparent 58%),
        radial-gradient(700px 480px at 88% 8%, rgba(32, 112, 240, 0.1), transparent 55%),
        radial-gradient(600px 400px at 70% 90%, rgba(217, 44, 44, 0.05), transparent 60%),
        linear-gradient(180deg, #fbfcfd 0%, var(--bg) 42%, #e8ecf2 100%);
      --phone-shell: linear-gradient(160deg, #2a303a 0%, #12151b 100%);
      --phone-screen: #e8ebf0;
      --hero-glow: rgba(217, 44, 44, 0.22);
      --shot-caption: var(--muted);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #10141b;
        --text: #eef1f6;
        --muted: #9aa3b2;
        --page-bg:
          radial-gradient(900px 520px at 12% -10%, rgba(217, 44, 44, 0.22), transparent 58%),
          radial-gradient(700px 480px at 88% 8%, rgba(32, 112, 240, 0.16), transparent 55%),
          radial-gradient(600px 400px at 70% 90%, rgba(217, 44, 44, 0.08), transparent 60%),
          linear-gradient(180deg, #0c1016 0%, var(--bg) 45%, #0a0d12 100%);
        --phone-shell: linear-gradient(160deg, #3a424e 0%, #1a1f28 100%);
        --phone-screen: #1c2129;
        --hero-glow: rgba(217, 44, 44, 0.3);
      }
      .phone { --screen-fill: var(--phone-screen); }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    html, body {
      margin: 0;
      min-height: 100%;
      color: var(--text);
      font-family: var(--font);
      line-height: 1.5;
      background: var(--page-bg);
      background-attachment: fixed;
    }
    a { color: inherit; }
    .page {
      width: min(1180px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 5.25rem 0 4.5rem;
    }

    /* —— Hero: one composition —— */
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: center;
      min-height: calc(100svh - 6.5rem);
      margin-bottom: clamp(3rem, 8vw, 5.5rem);
      overflow: visible;
    }
    .hero > * { overflow: visible; min-width: 0; }
    .hero-copy {
      display: grid;
      gap: 1.35rem;
      max-width: 34rem;
      opacity: 0;
      transform: translateY(18px);
      animation: rise 0.9s var(--ease) 0.05s forwards;
    }
    .brand {
      font-family: var(--display);
      font-size: clamp(3rem, 7vw, 4.6rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 0.98;
      margin: 0;
    }
    .lead {
      margin: 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 2.2vw, 1.22rem);
      max-width: 30rem;
      font-weight: 500;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-top: 0.25rem;
    }
    .store-badge {
      display: inline-block;
      line-height: 0;
      border-radius: 10px;
      text-decoration: none;
      transition: transform 0.28s var(--ease), filter 0.28s ease;
      filter: drop-shadow(0 10px 22px rgba(20, 24, 32, 0.16));
      -webkit-tap-highlight-color: transparent;
    }
    .store-badge img {
      display: block;
      height: 52px;
      width: auto;
      border-radius: 10px;
    }
    .store-badge--apk img {
      height: 42px;
      opacity: 0.92;
    }
    .store-badge picture { display: block; line-height: 0; }
    .store-badge:hover {
      transform: translateY(-3px) scale(1.03);
      filter: drop-shadow(0 16px 30px rgba(20, 24, 32, 0.22));
    }
    .store-badge:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    .store-badge:active { transform: translateY(-1px) scale(0.99); }
    .meta {
      margin: 0;
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 500;
    }
    .meta a {
      color: var(--text);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .meta a:hover { color: var(--accent); }
    .trust {
      margin: -0.35rem 0 0;
      color: var(--muted);
      font-size: 0.84rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .apk-note {
      margin: 0;
      color: var(--muted);
      font-size: 0.84rem;
      font-weight: 500;
      max-width: 30rem;
      line-height: 1.45;
    }
    .apk-note a {
      color: var(--text);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .apk-note a:hover { color: var(--accent); }

    /* Phone stage */
    .hero-stage {
      position: relative;
      min-height: 620px;
      display: grid;
      place-items: center;
      overflow: visible;
      padding: 1.75rem 3.75rem 2.25rem;
      opacity: 0;
      transform: translateY(24px) scale(0.98);
      animation: rise 1s var(--ease) 0.18s forwards;
    }
    .hero-glow {
      position: absolute;
      inset: 12% 18% 8%;
      background: radial-gradient(circle at 50% 40%, var(--hero-glow), transparent 62%);
      filter: blur(8px);
      pointer-events: none;
      animation: pulse 5.5s ease-in-out infinite;
    }
    .phone {
      --bezel: 1.5px;
      --ui-zoom: 0.99;
      --phone-radius: 2rem;
      --screen-fill: #f7f7f8;
      position: relative;
      width: min(100%, 280px);
      aspect-ratio: 9 / 19.4;
      padding: 0;
      border-radius: var(--phone-radius);
      /* Фон = экран (не корпус): scale не должен открывать тёмные «толстые» края */
      background: var(--screen-fill);
      box-shadow:
        0 30px 60px rgba(20, 24, 32, 0.28),
        0 8px 20px rgba(20, 24, 32, 0.18);
      overflow: hidden;
    }
    /* Волосяная тёмная кромка */
    .phone::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 var(--bezel) #0e1116;
      pointer-events: none;
      z-index: 4;
    }
    .phone::before {
      content: "";
      position: absolute;
      top: 7px;
      left: 50%;
      width: 22%;
      height: 0.4rem;
      transform: translateX(-50%);
      border-radius: 999px;
      background: #0a0c10;
      z-index: 5;
      pointer-events: none;
    }
    .phone > img,
    .phone > video,
    .phone .phone-media {
      position: absolute;
      top: 0;
      left: 0;
      right: auto;
      bottom: auto;
      box-sizing: border-box;
      width: 100% !important;
      height: 100% !important;
      max-width: none;
      margin: 0;
      padding: 0;
      display: block;
      object-fit: cover;
      object-position: center center;
      border-radius: inherit;
      background: transparent;
      transform: scale(var(--ui-zoom));
      transform-origin: center center;
    }
    .phone--hero .phone-media--still {
      display: block;
      z-index: 0;
    }
    .phone--hero .phone-media--video {
      display: block;
      z-index: 1;
      background: transparent;
    }
    .phone--hero {
      width: min(100%, 352px);
      z-index: 2;
      animation: float 6s ease-in-out infinite;
    }
    .phone--sat {
      position: absolute;
      width: min(26%, 118px);
      opacity: 0.9;
      z-index: 1;
      filter: saturate(0.95);
      animation: float 7.2s ease-in-out infinite;
    }
    .phone--sat-left {
      left: 2rem;
      top: 22%;
      transform: rotate(-10deg);
      animation-delay: -1.4s;
    }
    .phone--sat-right {
      right: 2rem;
      bottom: 16%;
      transform: rotate(9deg);
      animation-delay: -2.8s;
      opacity: 0.88;
    }

    /* Gallery */
    .gallery {
      display: grid;
      gap: 1.75rem;
    }
    .gallery-head {
      max-width: 36rem;
      display: grid;
      gap: 0.55rem;
    }
    .gallery-head h2 {
      margin: 0;
      font-family: var(--display);
      font-size: clamp(1.8rem, 3.5vw, 2.4rem);
      letter-spacing: -0.025em;
      line-height: 1.15;
    }
    .gallery-head p {
      margin: 0;
      color: var(--muted);
      font-size: 1.05rem;
      font-weight: 500;
    }
    .rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(170px, 210px);
      gap: 1.25rem;
      overflow-x: auto;
      padding: 0.5rem 0.15rem 1.4rem;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: rgba(26, 31, 42, 0.25) transparent;
    }
    .shot {
      margin: 0;
      scroll-snap-align: start;
      display: grid;
      gap: 0.7rem;
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    }
    .shot.is-in {
      opacity: 1;
      transform: none;
    }
    .shot .phone {
      width: 100%;
      transition: transform 0.35s var(--ease);
    }
    .shot:hover .phone {
      transform: translateY(-6px);
    }
    .shot figcaption {
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      padding-inline: 0.2rem;
    }

    /* FAQ */
    .faq {
      margin-top: clamp(2.75rem, 7vw, 4.5rem);
      display: grid;
      gap: 1.25rem;
      max-width: 42rem;
    }
    .faq h2 {
      margin: 0;
      font-family: var(--display);
      font-size: clamp(1.55rem, 3vw, 2rem);
      letter-spacing: -0.025em;
      line-height: 1.2;
    }
    .faq-list {
      margin: 0;
      display: grid;
      gap: 0.85rem;
    }
    .faq-item {
      margin: 0;
      padding: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--muted) 22%, transparent);
    }
    .faq-item:last-child { border-bottom: 0; }
    .faq-item summary {
      list-style: none;
      cursor: pointer;
      font-weight: 700;
      font-size: 1.02rem;
      letter-spacing: -0.015em;
      padding: 0.85rem 1.6rem 0.85rem 0;
      position: relative;
      color: var(--text);
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: "+";
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      color: var(--accent);
      font-weight: 700;
      font-size: 1.25rem;
      line-height: 1;
    }
    .faq-item[open] summary::after { content: "–"; }
    .faq-item p {
      margin: 0 0 1rem;
      color: var(--muted);
      font-size: 0.95rem;
      font-weight: 500;
      line-height: 1.55;
      max-width: 38rem;
    }

    @keyframes rise {
      to { opacity: 1; transform: none; }
    }
    @keyframes float {
      0%, 100% { translate: 0 0; }
      50% { translate: 0 -10px; }
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.7; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.04); }
    }

    @media (max-width: 960px) {
      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
        gap: 2.25rem;
      }
      .hero-copy { max-width: none; }
      .hero-stage {
        min-height: 520px;
        order: -1;
      }
      .phone--hero { width: min(62%, 300px); }
      .phone--sat { width: min(28%, 128px); }
    }
    @media (max-width: 640px) {
      .page { padding-top: 4.5rem; }
      .store-badge img { height: 46px; }
      .store-badge--apk img { height: 38px; }
      .hero-stage {
        min-height: 420px;
      }
      .phone--hero { width: min(72%, 280px); }
      .phone--sat { display: none; }
      .rail { grid-auto-columns: minmax(150px, 72vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .hero-copy, .hero-stage {
        opacity: 1;
        transform: none;
        animation: none;
      }
      .hero-glow, .phone--hero, .phone--sat { animation: none; }
      .store-badge, .shot, .shot .phone { transition: none; }
      .store-badge:hover, .shot:hover .phone { transform: none; }
      .shot { opacity: 1; transform: none; }
      .phone--hero .phone-media--video { opacity: 0; }
      .phone--hero .phone-media--still { display: block; }
    }
  </style>
</head>
<body>
  <main class="page">
    {% set badgeLang = 'ru' if locale == 'ru' else 'en' %}
    <section class="hero" aria-labelledby="app-title">
      <div class="hero-copy">
        <h1 id="app-title" class="brand">Serpmonn</h1>
        <p class="lead">{{ serpmonnAppTranslations[locale].app.lead }}</p>
        <div class="cta-row">
          <a class="store-badge" id="cta-play" href="https://play.google.com/store/apps/details?id=ru.serpmonn" target="_blank" rel="noopener" aria-label="Google Play">
            <picture>
              <source media="(prefers-color-scheme: dark)" srcset="/frontend/images/stores/badge-google-play-{{ badgeLang }}-light.svg?v=13">
              <img src="/frontend/images/stores/badge-google-play-{{ badgeLang }}.svg?v=13" width="180" height="54" alt="Google Play">
            </picture>
          </a>
          <a class="store-badge" id="cta-rustore" href="https://www.rustore.ru/catalog/app/ru.serpmonn" target="_blank" rel="noopener" aria-label="RuStore">
            <picture>
              <source media="(prefers-color-scheme: dark)" srcset="/frontend/images/stores/badge-rustore-{{ badgeLang }}-light.svg?v=13">
              <img src="/frontend/images/stores/badge-rustore-{{ badgeLang }}.svg?v=13" width="180" height="54" alt="RuStore">
            </picture>
          </a>
          <a class="store-badge store-badge--apk" id="cta-apk" href="/frontend/downloads/serpmonn/Serpmonn-1.2.7.apk" download="Serpmonn-1.2.7.apk" aria-label="{{ serpmonnAppTranslations[locale].app.ctaApk }}">
            <picture>
              <source media="(prefers-color-scheme: dark)" srcset="/frontend/images/stores/badge-serpmonn-{{ badgeLang }}-light.svg?v=13">
              <img src="/frontend/images/stores/badge-serpmonn-{{ badgeLang }}.svg?v=13" width="180" height="54" alt="{{ serpmonnAppTranslations[locale].app.ctaApkName }}">
            </picture>
          </a>
        </div>
        <p class="meta">
          {{ serpmonnAppTranslations[locale].app.metaBefore }}
          <a href="{{ installGuideHref }}">{{ serpmonnAppTranslations[locale].app.version }}</a>
        </p>
        <p class="trust">{{ serpmonnAppTranslations[locale].app.trustLine }}</p>
        <p class="apk-note">
          {{ serpmonnAppTranslations[locale].app.noteWarn }}
          {{ serpmonnAppTranslations[locale].app.noteMore }}
          <a href="{{ installGuideHref }}">{{ serpmonnAppTranslations[locale].app.noteGuide }}</a>
        </p>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <div class="hero-glow"></div>
        <div class="phone phone--sat phone--sat-left">
          <img src="/frontend/downloads/serpmonn/rustore-screenshots/05-search.png?v=13" alt="" width="360" height="780" loading="eager">
        </div>
        <div class="phone phone--hero">
          {% set heroVideo = 'ru' if locale == 'ru' else 'en' %}
          <video
            class="phone-media phone-media--video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/frontend/downloads/serpmonn/rustore-screenshots/01-profile-feed.png?v=13"
            width="360"
            height="780"
          >
            <source src="/frontend/images/stores/hero-preview-{{ heroVideo }}.mp4?v=22" type="video/mp4">
          </video>
          <img
            class="phone-media phone-media--still"
            src="/frontend/downloads/serpmonn/rustore-screenshots/01-profile-feed.png?v=13"
            alt=""
            width="360"
            height="780"
            loading="eager"
          >
        </div>
        <div class="phone phone--sat phone--sat-right">
          <img src="/frontend/downloads/serpmonn/rustore-screenshots/03-games.png?v=22" alt="" width="360" height="780" loading="eager">
        </div>
      </div>
    </section>

    <section class="gallery" aria-labelledby="gallery-title">
      <div class="gallery-head">
        <h2 id="gallery-title">{{ serpmonnAppTranslations[locale].app.galleryTitle }}</h2>
        <p>{{ serpmonnAppTranslations[locale].app.galleryLead }}</p>
      </div>
      <div class="rail" aria-label="{{ serpmonnAppTranslations[locale].app.shotsAria }}">
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/01-profile-feed.png?v=13" alt="{{ serpmonnAppTranslations[locale].app.altFeed }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capFeed }}</figcaption>
        </figure>
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/08-messages.png?v=21" alt="{{ serpmonnAppTranslations[locale].app.altMessages }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capMessages }}</figcaption>
        </figure>
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/05-search.png?v=13" alt="{{ serpmonnAppTranslations[locale].app.altSearch }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capSearch }}</figcaption>
        </figure>
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/03-news.png?v=13" alt="{{ serpmonnAppTranslations[locale].app.altNews }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capNews }}</figcaption>
        </figure>
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/04-tools.png?v=13" alt="{{ serpmonnAppTranslations[locale].app.altTools }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capTools }}</figcaption>
        </figure>
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/03-games.png?v=22" alt="{{ serpmonnAppTranslations[locale].app.altGames }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capGames }}</figcaption>
        </figure>
        <figure class="shot">
          <div class="phone"><img src="/frontend/downloads/serpmonn/rustore-screenshots/06-profile.png?v=13" alt="{{ serpmonnAppTranslations[locale].app.altProfile }}" width="360" height="780" loading="lazy"></div>
          <figcaption>{{ serpmonnAppTranslations[locale].app.capProfile }}</figcaption>
        </figure>
