---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{% if locale == 'ru' %}/frontend/games/rat/index.html{% else %}/frontend/{{ locale }}/games/rat/index.html{% endif %}"
eleventyComputed:
  title: "{{ gameRatTranslations[locale].gameRat.pageTitle }}"
  dir: "{% if rtlLocales.indexOf(locale) != -1 %}rtl{% else %}ltr{% endif %}"
---

<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}" data-themes="light dark" data-langs="{% for loc in locales %}{{ loc }}{% if not loop.last %} {% endif %}{% endfor %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ title }}</title>
  {% set hreflangPath = "games/rat/index.html" %}
  {% include "partials/hreflang-locales.njk" %}
  <link rel="icon" href="/frontend/images/serpmonn.ico?v=3" type="image/x-icon">
  <script>
    (function () {
      try {
        var t = localStorage.getItem('spn_theme');
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.style.colorScheme = t;
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/frontend/styles/styles.css">
  <link rel="stylesheet" href="/frontend/styles/base.css">
  <link rel="stylesheet" href="/frontend/styles/accessibility.css">
  <link rel="stylesheet" href="/frontend/styles/menu.css">
  <link rel="stylesheet" href="/frontend/styles/ad-top-banner.css">
  <script type="module" src="/frontend/scripts/menu-loader.js" defer></script>
  <script>
  (function () {
    function loadMailAds() {
      if (document.querySelector('script[src*="ads-async.js"]')) return;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://ad.mail.ru/static/ads-async.js';
      document.head.appendChild(s);
    }
    function schedule() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function () { setTimeout(loadMailAds, 2000); }, { timeout: 5000 });
      } else {
        setTimeout(loadMailAds, 2500);
      }
    }
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule);
  })();
</script>
  <link rel="stylesheet" href="/frontend/fonts/rat-typing.css?v=1">
  <style>
    .rat-game {
      width: 100%;
      max-width: 420px;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      color: var(--text);
      font-family: var(--font-body);
      --bg: #0e0f11;
      --surface: #16181c;
      --surface2: #1e2027;
      --border: #2a2d36;
      --text: #e8e9ec;
      --muted: #7b7e8a;
      --primary: #f0c040;
      --primary-dim: #b89020;
      --wall: #23262f;
      --wall-edge: rgba(255,255,255,0.04);
      --food-color: #ff6b35;
      --bonus-color: #a78bfa;
      --rat-base: #c8a882;
      --canvas-bg: #0e0f11;
      --overlay-bg: rgba(14,15,17,0.9);
      --btn-ink: #0e0f11;
      --font-mono: 'Share Tech Mono', monospace;
      --font-body: 'Inter', sans-serif;
      --wrap-shadow: 0 0 40px rgba(240,192,64,0.06), 0 8px 32px rgba(0,0,0,0.6);
    }
    html[data-theme="light"] .rat-game {
      --bg: #f4f2ec;
      --surface: #ffffff;
      --surface2: #efece4;
      --border: #d8d2c6;
      --text: #1c1a16;
      --muted: #6b655c;
      --primary: #c48912;
      --primary-dim: #9a6c0e;
      --wall: #3a3630;
      --wall-edge: rgba(255,255,255,0.12);
      --food-color: #ff6b35;
      --bonus-color: #7c5cbf;
      --rat-base: #c8a882;
      --canvas-bg: #ebe6dc;
      --overlay-bg: rgba(244,242,236,0.92);
      --btn-ink: #1c1a16;
      --wrap-shadow: 0 0 28px rgba(196,137,18,0.12), 0 8px 24px rgba(28,26,22,0.12);
    }
    .rat-game *, .rat-game *::before, .rat-game *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      max-width: 100%;
    }
    body.rat-page {
      min-height: 100dvh;
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
      box-sizing: border-box;
      background: var(--bg, #0e0f11);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0.75rem;
      padding-left: max(0.75rem, env(safe-area-inset-left));
      padding-right: max(0.75rem, env(safe-area-inset-right));
      gap: 0.75rem;
    }
    html[data-theme="dark"] body.rat-page {
      background:
        radial-gradient(900px 480px at 12% -10%, rgba(240,192,64,0.08), transparent 55%),
        #0e0f11;
    }
    html[data-theme="light"] body.rat-page {
      background:
        radial-gradient(900px 480px at 12% -10%, rgba(196,137,18,0.12), transparent 55%),
        #f4f2ec;
    }
    .header { display: flex; align-items: center; gap: 0.75rem; }
    .header h1 {
      font-family: var(--font-mono);
      font-size: 1.3rem;
      color: var(--primary);
      letter-spacing: 0.06em;
    }
    .header h1 span { color: var(--muted); font-size: 0.8rem; }
    .header-icon-bg { fill: var(--surface); }

    .scoreboard {
      display: flex;
      gap: 0.45rem;
      position: relative;
      width: 100%;
      max-width: 420px;
      min-width: 0;
    }
    .score-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 0.4rem 0.45rem;
      text-align: center;
      flex: 1 1 0;
      min-width: 0;
    }
    .score-label {
      font-size: 0.58rem; font-family: var(--font-mono);
      color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .score-value {
      font-family: var(--font-mono); font-size: 1.35rem;
      color: var(--primary); line-height: 1.2;
    }
    .score-value.combo-flash {
      animation: comboPop 0.45s ease;
      color: #ff6b35;
    }
    @keyframes comboPop {
      0% { transform: scale(1); }
      40% { transform: scale(1.28); }
      100% { transform: scale(1); }
    }
    .combo-badge {
      position: absolute;
      right: 0;
      top: -0.65rem;
      max-width: 46%;
      overflow: hidden;
      text-overflow: ellipsis;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #0e0f11;
      background: linear-gradient(90deg, #f0c040, #ff6b35);
      border-radius: 999px;
      padding: 0.15rem 0.55rem;
      opacity: 0;
      transform: translateY(4px);
      pointer-events: none;
      transition: opacity 0.15s, transform 0.15s;
    }
    .combo-badge.on { opacity: 1; transform: translateY(0); }

    .toolbar {
      display: flex; flex-wrap: wrap; gap: 0.45rem;
      width: 420px; max-width: 100%;
      justify-content: center;
    }
    .toolbar .btn {
      padding: 0.45rem 0.85rem;
      font-size: 0.75rem;
    }
    .btn.ghost {
      background: transparent;
      color: var(--primary);
      border: 1px solid var(--border);
    }
    .btn.ghost:hover { border-color: var(--primary); filter: none; }

    .nickname-panel {
      width: 420px; max-width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 0.75rem;
      display: grid;
      gap: 0.5rem;
    }
    .nickname-panel[hidden] { display: none !important; }
    .nickname-panel label {
      font-size: 0.72rem;
      color: var(--muted);
      font-family: var(--font-mono);
    }
    .nickname-panel input {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      color: var(--text);
      padding: 0.5rem 0.65rem;
      font-family: var(--font-mono);
    }
    .nick-row { display: flex; gap: 0.45rem; flex-wrap: wrap; }

    .canvas-wrap {
      position: relative;
      width: 100%;
      max-width: 420px;
      border-radius: 1rem;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--wrap-shadow);
      cursor: pointer;
      transition: transform 0.08s linear;
      min-width: 0;
    }
    .canvas-wrap.shake { animation: ratShake 0.28s ease; }
    .canvas-wrap.near-flash::after {
      content: '';
      position: absolute; inset: 0;
      background: rgba(255,107,53,0.14);
      pointer-events: none;
      animation: nearFlash 0.28s ease;
    }
    @keyframes ratShake {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(-3px, 1px); }
      50% { transform: translate(3px, -2px); }
      75% { transform: translate(-2px, 1px); }
    }
    @keyframes nearFlash { 0% { opacity: 1; } 100% { opacity: 0; } }
    canvas#c {
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
    }

    .toast {
      position: absolute;
      left: 50%;
      bottom: 1rem;
      transform: translateX(-50%) translateY(8px);
      background: rgba(0,0,0,0.78);
      color: #fff;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s, transform 0.2s;
      z-index: 3;
      white-space: nowrap;
      max-width: calc(100% - 1rem);
      overflow: hidden;
      text-overflow: ellipsis;
      box-sizing: border-box;
    }
    html[data-theme="light"] .toast { background: rgba(28,26,22,0.88); }
    .toast.on { opacity: 1; transform: translateX(-50%) translateY(0); }

    .overlay {
      position: absolute; inset: 0;
      background: var(--overlay-bg);
      backdrop-filter: blur(6px);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 0.85rem;
      border-radius: 1rem;
      transition: opacity 0.2s;
      padding: 1rem;
    }
    .overlay.hidden { opacity: 0; pointer-events: none; }
    .overlay-title {
      font-family: var(--font-mono); font-size: 1.45rem;
      color: var(--primary); letter-spacing: 0.06em;
      text-align: center;
    }
    .overlay-sub {
      color: var(--muted); font-size: 0.82rem;
      text-align: center; line-height: 1.7; max-width: 280px;
    }
    .overlay-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; justify-content: center; }
    .btn {
      background: var(--primary); color: var(--btn-ink);
      font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700;
      letter-spacing: 0.08em; border: none; border-radius: 0.5rem;
      padding: 0.6rem 1.75rem; cursor: pointer;
      transition: background 0.15s, transform 0.1s, filter 0.15s;
    }
    .btn:hover { filter: brightness(1.08); }
    .btn:active { transform: scale(0.97); }

    .hint {
      font-size: 0.7rem; color: var(--muted);
      font-family: var(--font-mono); letter-spacing: 0.04em;
      text-align: center;
    }

    .fat-meta {
      width: 420px; max-width: 100%;
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 0.25rem;
    }
    .fat-stage {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary);
    }
    .fat-bar-wrap {
      width: 420px; max-width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      height: 10px;
      overflow: hidden;
    }
    .fat-bar {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #f0c040, #ff6b35);
      transition: width 0.3s ease;
      width: 0%;
    }
  </style>
</head>
<body class="rat-page">
  <div id="menuContainer"></div>

<div class="rat-game">

<div class="ad-top-banner" style="width:100%;max-width:420px;text-align:center;margin:0 auto 12px;">
  <ins class="mrg-tag" style="display:inline-block;" data-ad-client="ad-{{ mailAds.slots.top.id }}" data-ad-slot="{{ mailAds.slots.top.id }}"></ins>
</div>

<div class="header">
  <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
    <rect class="header-icon-bg" width="30" height="30" rx="7"/>
    <ellipse cx="15" cy="17" rx="7" ry="5" fill="#c8a882"/>
    <ellipse cx="21" cy="13" rx="4" ry="3.5" fill="#c8a882"/>
    <ellipse cx="20" cy="10" rx="2" ry="1.5" fill="#e8c0a0"/>
    <circle cx="22.5" cy="12.5" r="1" fill="#1a0a0a"/>
    <path d="M8 18 Q4 16 3 20" stroke="#a07050" stroke-width="1.5" fill="none" stroke-linecap="round"/>
    <circle cx="25" cy="7" r="2.5" fill="#ff6b35"/>
  </svg>
  <h1>FAT RAT</h1>
</div>

<div class="scoreboard">
  <div class="score-item">
    <div class="score-label">{{ gameRatTranslations[locale].gameRat.eatenLabel }}</div>
    <div class="score-value" id="eaten">0</div>
  </div>
  <div class="score-item">
    <div class="score-label">{{ gameRatTranslations[locale].gameRat.weightLabel }}</div>
    <div class="score-value" id="weight">0.1</div>
  </div>
  <div class="score-item">
    <div class="score-label">{{ gameRatTranslations[locale].gameRat.bestLabel }}</div>
    <div class="score-value" id="best">0</div>
  </div>
  <div class="combo-badge" id="comboBadge" aria-hidden="true"></div>
</div>

<div class="fat-meta">
  <span class="fat-stage" id="fatStage">{{ gameRatTranslations[locale].gameRat.stageSlim }}</span>
  <span class="fat-stage" id="nickValue" style="color:var(--muted)">—</span>
</div>
<div class="fat-bar-wrap"><div class="fat-bar" id="fatBar"></div></div>

<form id="nicknameForm" class="nickname-panel" hidden>
  <label for="nickname">{{ gameRatTranslations[locale].gameRat.nickLabel }}</label>
  <input type="text" id="nickname" maxlength="24" placeholder="{{ gameRatTranslations[locale].gameRat.nickPlaceholder }}" autocomplete="nickname">
  <div class="nick-row">
    <button type="submit" class="btn">{{ gameRatTranslations[locale].gameRat.nickSave }}</button>
    <button type="button" class="btn ghost" id="btnSkipNick">{{ gameRatTranslations[locale].gameRat.nickSkip }}</button>
  </div>
</form>

<div class="toolbar">
  <button class="btn ghost" id="btnPause" type="button" hidden>{{ gameRatTranslations[locale].gameRat.pauseBtn }}</button>
  <button class="btn ghost" id="btnSound" type="button" aria-pressed="true">{{ gameRatTranslations[locale].gameRat.soundOn }}</button>
  <button class="btn ghost" id="btnChangeNick" type="button">{{ gameRatTranslations[locale].gameRat.setNick }}</button>
  <button class="btn ghost" id="btnLeaderboard" type="button">{{ gameRatTranslations[locale].gameRat.leaderboardBtn }}</button>
</div>

<div class="canvas-wrap" id="canvasWrap">
  <canvas id="c" width="420" height="420"></canvas>
  <div class="toast" id="toast" aria-live="polite"></div>
  <div class="overlay" id="overlay">
    <div class="overlay-title">FAT RAT</div>
    <div class="overlay-sub" id="overlaySub">
      {{ gameRatTranslations[locale].gameRat.overlayLine1 }}<br>
      {{ gameRatTranslations[locale].gameRat.overlayLine2 }}<br>
      <span style="color:var(--bonus-color)">{{ gameRatTranslations[locale].gameRat.bonusFoodLabel }}</span>{{ gameRatTranslations[locale].gameRat.overlayLine3 }}<br>
      {{ gameRatTranslations[locale].gameRat.overlayGoal }}
    </div>
    <div class="overlay-actions">
      <button class="btn" id="startBtn">{{ gameRatTranslations[locale].gameRat.startBtn }}</button>
      <button class="btn ghost" id="shareBtn" type="button" hidden>{{ gameRatTranslations[locale].gameRat.shareBtn }}</button>
    </div>
  </div>
</div>

<div class="hint" id="hint">{{ gameRatTranslations[locale].gameRat.hint }}</div>

<script type="module" src="/frontend/games/rat/rat-ads.js?v=1" defer></script>
<script>
window.i18n = {
  gameOverTitle: {{ gameRatTranslations[locale].gameRat.gameOverTitle | dump | safe }},
  tooFatTitle: {{ gameRatTranslations[locale].gameRat.tooFatTitle | dump | safe }},
  catCaughtTitle: {{ gameRatTranslations[locale].gameRat.catCaughtTitle | dump | safe }},
  stageSlim: {{ gameRatTranslations[locale].gameRat.stageSlim | dump | safe }},
  stageChonk: {{ gameRatTranslations[locale].gameRat.stageChonk | dump | safe }},
  stageStuck: {{ gameRatTranslations[locale].gameRat.stageStuck | dump | safe }},
  comboLabel: {{ gameRatTranslations[locale].gameRat.comboLabel | dump | safe }},
  weightLabel: {{ gameRatTranslations[locale].gameRat.weightLabel | dump | safe }},
  soundOn: {{ gameRatTranslations[locale].gameRat.soundOn | dump | safe }},
  soundOff: {{ gameRatTranslations[locale].gameRat.soundOff | dump | safe }},
  pauseBtn: {{ gameRatTranslations[locale].gameRat.pauseBtn | dump | safe }},
  resumeBtn: {{ gameRatTranslations[locale].gameRat.resumeBtn | dump | safe }},
  shareBtn: {{ gameRatTranslations[locale].gameRat.shareBtn | dump | safe }},
  shareCopied: {{ gameRatTranslations[locale].gameRat.shareCopied | dump | safe }},
  shareText: {{ gameRatTranslations[locale].gameRat.shareText | dump | safe }},
  changeNick: {{ gameRatTranslations[locale].gameRat.changeNick | dump | safe }},
  setNick: {{ gameRatTranslations[locale].gameRat.setNick | dump | safe }},
  bannedNicknameAlert: {{ gameRatTranslations[locale].gameRat.bannedNicknameAlert | dump | safe }},
  fleeHint: {{ gameRatTranslations[locale].gameRat.fleeHint | dump | safe }},
  pausedHint: {{ gameRatTranslations[locale].gameRat.pausedHint | dump | safe }},
  scoreTableUrl: {{ gameRatTranslations[locale].gameRat.scoreTableUrl | dump | safe }},
  overlayLine1: {{ gameRatTranslations[locale].gameRat.overlayLine1 | dump | safe }},
  overlayLine2: {{ gameRatTranslations[locale].gameRat.overlayLine2 | dump | safe }},
  bonusFoodLabel: {{ gameRatTranslations[locale].gameRat.bonusFoodLabel | dump | safe }},
  overlayLine3: {{ gameRatTranslations[locale].gameRat.overlayLine3 | dump | safe }},
  overlayGoal: {{ gameRatTranslations[locale].gameRat.overlayGoal | dump | safe }},
  hintDefault: {{ gameRatTranslations[locale].gameRat.hint | dump | safe }}
};
</script>
<script src="/frontend/games/rat/rat-game.js?v=5" defer></script>
</div>
  {% from "partials/mobile-anchor-ad.njk" import mobileAnchor %}
  {{ mobileAnchor(localesNews[locale].news.closeAd) }}
{% include "partials/ad-pool-init.njk" %}
</body>
</html>
