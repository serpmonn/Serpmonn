    <script type="module" src="/frontend/promo-codes-and-discounts/promokody-skidki.js?v=63" defer></script>
    <script>
  (function () {
    function loadMailAds() {
      if (document.querySelector('script[src*="ads-async.js"]')) return;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://ad.mail.ru/static/ads-async.js';
      document.head.appendChild(s);
    }
    function schedule() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function () { setTimeout(loadMailAds, 2000); }, { timeout: 5000 });
      } else {
        setTimeout(loadMailAds, 2500);
      }
    }
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule);
  })();
</script>
    <script type="module" src="/frontend/scripts/menu-loader.js" defer></script>
</head>
<body>
    <header>
        <nav id="main-nav" aria-label="{{ localesPromocodes[locale].promoCodes.mainNavLabel }}"></nav>
    </header>
    
    {% set pc = localesPromocodes[locale].promoCodes %}
    {% set brand = pc.brandName or ( 'Серпмонн' if locale == 'ru' else 'Serpmonn' ) %}
    {% set codesCount = promocodesBuild.stats.active or promocodesBuild.stats.total or 0 %}
    {% set codesTotal = promocodesBuild.stats.total or 0 %}
    <main class="container">
        <section class="stats-controls" aria-labelledby="overview-title">
            <div class="stats-bar">
                <img class="brand-logo" src="/frontend/images/serpmonn-512.png?v=4" width="28" height="28" alt="" decoding="async">
                <span class="brand-name">{{ brand }}</span>
                <span class="meta-sep" aria-hidden="true">·</span>
                <h1 id="overview-title">{{ pc.heroTitle }}</h1>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span
                    id="codesMetaText"
                    data-codes-template="{{ pc.codesMeta }}"
                    data-codes-active-total-template="{{ pc.codesMetaActiveTotal }}"
                >{% if codesCount == codesTotal %}{{ pc.codesMeta | replace('{count}', codesCount) }}{% else %}{{ pc.codesMetaActiveTotal | replace('{active}', codesCount) | replace('{total}', codesTotal) }}{% endif %}</span>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span class="stats-updated">
                    {{ pc.lastUpdated }}
                    <span id="lastUpdate">{{ promocodesBuild.stats.lastUpdateFormatted | default('-') }}</span>
                </span>
                <span id="activePromos" hidden>{{ codesCount }}</span>
                <span id="totalPromos" hidden>{{ codesTotal }}</span>
                <span id="totalStatChip" hidden></span>
                <div class="controls toolbar-actions">
                    <button id="toggleFilters" class="submit-btn toolbar-mobile-only" type="button" aria-expanded="false" aria-controls="filtersContent" aria-label="{{ pc.toggleFilters }}">{{ pc.toggleFilters }}</button>
                    <button id="sortByExpiryBtn" type="button" class="submit-btn toolbar-desktop-only" aria-label="{{ pc.sortByExpiry }}">{{ pc.sortByExpiry }}</button>
                    <button id="resetFiltersBtn" type="button" class="submit-btn toolbar-desktop-only" aria-label="{{ pc.resetFilters }}">{{ pc.resetFilters }}</button>
                </div>
            </div>
        </section>

        <section class="filters" aria-label="{{ localesPromocodes[locale].promoCodes.toggleFilters }}">
            <div id="filtersContent" style="display: none;">
                <div class="filter-row">
                    <label for="searchInput">{{ localesPromocodes[locale].promoCodes.searchPlaceholder }}</label>
                    <input type="text" id="searchInput" aria-label="{{ localesPromocodes[locale].promoCodes.searchPlaceholder }}" aria-describedby="search-hint">
                </div>
                <p id="search-hint" class="visually-hidden">{{ localesPromocodes[locale].promoCodes.searchHint }}</p>

                <div class="filter-row">
                    <label for="categorySelect">{{ localesPromocodes[locale].promoCodes.allCategories }}</label>
                    <select id="categorySelect" aria-label="{{ localesPromocodes[locale].promoCodes.allCategories }}">
                        <option value="">{{ localesPromocodes[locale].promoCodes.allCategories }}</option>
                        {% for cat in promocodesBuild.categories %}
                        <option value="{{ cat }}">{{ promoI18n[locale]['promo.cat.' ~ cat] | default(cat) }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-row">
                    <label for="statusSelect">{{ localesPromocodes[locale].promoCodes.allStatuses }}</label>
                    <select id="statusSelect" aria-label="{{ localesPromocodes[locale].promoCodes.allStatuses }}">
                        <option value="">{{ localesPromocodes[locale].promoCodes.allStatuses }}</option>
                        <option value="active">{{ localesPromocodes[locale].promoCodes.activeStatus }}</option>
                        <option value="expired">{{ localesPromocodes[locale].promoCodes.expiredStatus }}</option>
                    </select>
                </div>

                <div class="filter-row">
                    <label for="countrySelect">{{ localesPromocodes[locale].promoCodes.allCountries }}</label>
                    <select id="countrySelect" aria-label="{{ localesPromocodes[locale].promoCodes.allCountries }}">
                        <option value="" selected>{{ localesPromocodes[locale].promoCodes.allCountries }}</option>
                        <option value="Россия">{{ localesPromocodes[locale].promoCodes.russia }}</option>
                        <option value="Казахстан">{{ localesPromocodes[locale].promoCodes.kazakhstan }}</option>
                        <option value="Узбекистан">{{ localesPromocodes[locale].promoCodes.uzbekistan }}</option>
                        <option value="Грузия">{{ localesPromocodes[locale].promoCodes.georgia }}</option>
                    </select>
                </div>

                <div class="filter-actions toolbar-mobile-only">
                    <button id="sortByExpiryBtnMobile" type="button" class="submit-btn" aria-label="{{ localesPromocodes[locale].promoCodes.sortByExpiry }}">{{ localesPromocodes[locale].promoCodes.sortByExpiry }}</button>
                    <button id="resetFiltersBtnMobile" type="button" class="submit-btn" aria-label="{{ localesPromocodes[locale].promoCodes.resetFilters }}">{{ localesPromocodes[locale].promoCodes.resetFilters }}</button>
                </div>
            </div>
        </section>

        <div id="promoStickyBar" class="promo-sticky-bar" hidden>
            <input
                type="search"
                id="stickySearchInput"
                class="promo-sticky-search"
                placeholder="{{ localesPromocodes[locale].promoCodes.searchPlaceholder }}"
                aria-label="{{ localesPromocodes[locale].promoCodes.searchPlaceholder }}"
                enterkeyhint="search"
            >
            <button id="stickyToggleFilters" class="submit-btn" type="button" aria-expanded="false" aria-controls="filtersContent">{{ localesPromocodes[locale].promoCodes.toggleFilters }}</button>
        </div>

        <section class="bonus" aria-labelledby="bonus-title">
            <div class="bonus-inner">
                <div class="bonus-copy">
                    <h2 id="bonus-title">{{ localesPromocodes[locale].promoCodes.bonusTitle }}</h2>
                    <p class="bonus-lead">{{ localesPromocodes[locale].promoCodes.bonusText }}</p>
                </div>
                <p class="social-proof-count" id="subscribersCount" data-count-template="{{ localesPromocodes[locale].promoCodes.socialProofCount }}" aria-live="polite">
                    {{ localesPromocodes[locale].promoCodes.socialProofCount | replace('{count}', '…') }}
                </p>
                <form action="/subscribe" method="post" aria-label="{{ localesPromocodes[locale].promoCodes.bonusTitle }}">
                    <input
                        type="email"
                        name="email"
                        class="bonus-email"
                        placeholder="{{ localesPromocodes[locale].promoCodes.emailPlaceholder }}"
                        data-placeholder-desktop="{{ localesPromocodes[locale].promoCodes.emailPlaceholder }}"
                        data-placeholder-mobile="{{ localesPromocodes[locale].promoCodes.bonusEmailPlaceholderMobile | default(localesPromocodes[locale].promoCodes.bonusTitle) }}"
                        required
                        aria-label="{{ localesPromocodes[locale].promoCodes.emailPlaceholder }}"
                    >
                    <button type="submit" class="submit-btn">{{ localesPromocodes[locale].promoCodes.subscribeButton }}</button>
                </form>
            </div>
        </section>

        <div id="loadingSpinner" class="loading" style="display: none;">
            <div class="spinner"></div>
            <p>{{ localesPromocodes[locale].promoCodes.loading }}</p>
        </div>

        <section id="catalog" class="promo-grid" aria-label="{{ localesPromocodes[locale].promoCodes.catalogTitle }}" role="region">
            {% for promo in promocodesBuild.cards %}
            {{ renderPromoCard(promo, locale) }}
            {% endfor %}
        </section>

        <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title">{{ localesPromocodes[locale].promoCodes.faqTitle }}</h2>
            <details>
                <summary lang="{{ locale }}">{{ localesPromocodes[locale].promoCodes.faq1Question }}</summary>
                <p>{{ localesPromocodes[locale].promoCodes.faq1Answer | safe }}</p>
            </details>
            <details>
                <summary lang="{{ locale }}">{{ localesPromocodes[locale].promoCodes.faq2Question }}</summary>
                <p>{{ localesPromocodes[locale].promoCodes.faq2Answer | safe }}</p>
            </details>
            {% if localesPromocodes[locale].promoCodes.faq3Question %}
            <details>
                <summary lang="{{ locale }}">{{ localesPromocodes[locale].promoCodes.faq3Question }}</summary>
                <p>{{ localesPromocodes[locale].promoCodes.faq3Answer | safe }}</p>
            </details>
            {% endif %}
            {% if localesPromocodes[locale].promoCodes.faq4Question %}
            <details>
                <summary lang="{{ locale }}">{{ localesPromocodes[locale].promoCodes.faq4Question }}</summary>
                <p>{{ localesPromocodes[locale].promoCodes.faq4Answer | safe }}</p>
            </details>
            {% endif %}
            {% if localesPromocodes[locale].promoCodes.faq5Question %}
            <details>
                <summary lang="{{ locale }}">{{ localesPromocodes[locale].promoCodes.faq5Question }}</summary>
                <p>{{ localesPromocodes[locale].promoCodes.faq5Answer | safe }}</p>
            </details>
            {% endif %}
            {% if localesPromocodes[locale].promoCodes.faq6Question %}
            <details>
                <summary lang="{{ locale }}">{{ localesPromocodes[locale].promoCodes.faq6Question }}</summary>
                <p>{{ localesPromocodes[locale].promoCodes.faq6Answer | safe }}</p>
            </details>
            {% endif %}
        </section>
    </main>
    
    <footer>
        <p>{{ localesPromocodes[locale].promoCodes.footerText | safe }}</p>
    </footer>

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "{{ localesPromocodes[locale].promoCodes.breadcrumbHome }}",
                "item": "{{ site.baseUrl }}/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ localesPromocodes[locale].promoCodes.breadcrumbPromoCodes }}",
                "item": "{{ canonical }}"
            }
        ]
    }
    </script>
    
    <script type="application/ld+json">
    {
