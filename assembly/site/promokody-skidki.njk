---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{% if locale == 'ru' %}/frontend/promo-codes-and-discounts/promokody-skidki.html{% else %}/frontend/{{ locale }}/promo-codes-and-discounts/promokody-skidki.html{% endif %}"
eleventyComputed:
  dir: "{% if rtlLocales.indexOf(locale) != -1 %}rtl{% else %}ltr{% endif %}"
  canonical: "{% if locale == 'ru' %}{{ site.baseUrl }}/frontend/promo-codes-and-discounts/promokody-skidki.html{% else %}{{ site.baseUrl }}/frontend/{{ locale }}/promo-codes-and-discounts/promokody-skidki.html{% endif %}"
---
{% from "partials/promo-card-ssr.njk" import renderPromoCard %}

<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}" data-themes="light dark" data-langs="{% for loc, _ in localesPromocodes %}{{ loc }}{% if not loop.last %} {% endif %}{% endfor %}">
<head>
    <script>
      (function () {
        try {
          var t = localStorage.getItem('spn_theme');
          if (t !== 'light' && t !== 'dark') {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
          document.documentElement.style.colorScheme = t;
        } catch (e) {}
      })();
    </script>
    <link rel="stylesheet" href="/frontend/styles/styles.css">
    <meta http-equiv="Content-Language" content="{{ locale }}">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ localesPromocodes[locale].promoCodes.title }}</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <!-- Open Graph -->
    <meta property="og:title" content="{{ localesPromocodes[locale].promoCodes.ogTitle }}">
    <meta property="og:description" content="{{ localesPromocodes[locale].promoCodes.ogDescription }}">
    <meta property="og:image" content="{{ site.baseUrl }}/frontend/images/og-promocodes.png">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:type" content="website">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ localesPromocodes[locale].promoCodes.ogTitle }}">
    <meta name="twitter:description" content="{{ localesPromocodes[locale].promoCodes.twitterDescription }}">
    <meta name="twitter:image" content="{{ site.baseUrl }}/frontend/images/og-promocodes.png">

    <!-- Каноническая ссылка -->
    <link rel="canonical" href="{{ canonical }}" />

    <!-- Hreflang для всех языков -->
    {% for loc in locales %}
        {% if loc == 'ru' %}
            <link rel="alternate" href="{{ site.baseUrl }}/frontend/promo-codes-and-discounts/promokody-skidki.html" hreflang="{{ loc }}" />
        {% else %}
            <link rel="alternate" href="{{ site.baseUrl }}/frontend/{{ loc }}/promo-codes-and-discounts/promokody-skidki.html" hreflang="{{ loc }}" />
        {% endif %}
    {% endfor %}
    <link rel="alternate" href="{{ site.baseUrl }}/frontend/promo-codes-and-discounts/promokody-skidki.html" hreflang="x-default" />

    <!-- Мета-описание для SEO -->
    <meta name="description" content="{{ localesPromocodes[locale].promoCodes.metaDescription }}">
    <meta name="keywords" content="{{ localesPromocodes[locale].promoCodes.keywords }}">

    <!-- Favicon -->
    <link rel="icon" href="/frontend/images/serpmonn.ico?v=3" type="image/x-icon">

    <!-- Стили -->
    <link rel="stylesheet" href="/frontend/styles/accessibility.css">
    <link rel="stylesheet" href="/frontend/styles/menu.css?v=sn11">
    <link rel="stylesheet" href="/frontend/fonts/manrope.css?v=1">
    <link rel="stylesheet" href="/frontend/fonts/source-serif-4.css?v=1">
    <link rel="stylesheet" href="/frontend/promo-codes-and-discounts/promokody-skidki.css?v=87">
    <style id="promo-theme-bg">
      /* Тёплая аналоговая палитра — финальный выбор */
      :root {
        --bg: #f1efec;
        --text: #1c1917;
        --muted: #6f6a64;
        --accent: #b85c56;
        --ok: #6b7358;
        --font: "Manrope", system-ui, sans-serif;
        --display: "Source Serif 4", Georgia, serif;
        --page-bg:
          radial-gradient(1100px 640px at 8% -14%, rgba(184, 92, 86, 0.1), transparent 58%),
          radial-gradient(900px 560px at 92% 0%, rgba(107, 115, 88, 0.08), transparent 55%),
          radial-gradient(700px 480px at 60% 100%, rgba(184, 92, 86, 0.05), transparent 62%),
          linear-gradient(180deg, #faf9f7 0%, var(--bg) 38%, #ebe8e4 100%);
      }
      html[data-theme="dark"] {
        --bg: #141210;
        --text: #e8e4df;
        --muted: #9a948c;
        --accent: #c48882;
        --ok: #8a9178;
        --page-bg:
          radial-gradient(900px 520px at 10% -10%, rgba(196, 136, 130, 0.09), transparent 55%),
          radial-gradient(800px 480px at 90% 0%, rgba(138, 145, 120, 0.06), transparent 52%),
          linear-gradient(180deg, #100e0c 0%, var(--bg) 45%, #0f0d0b 100%);
      }
      html, body {
        background: var(--page-bg) !important;
        background-attachment: fixed !important;
        color: var(--text);
        font-family: var(--font);
      }
      @media (max-width: 768px) {
        html, body { background-attachment: scroll !important; }
      }
    </style>

    <!-- Скрипты -->
    <script>
        (function() {
            const KEY = 'serpmonn_promos_version';
            async function checkVersion() {
                try {
                    const res = await fetch('/api/promocodes/version', { cache: 'no-store' });
                    if (!res.ok) return;
                    const data = await res.json();
                    const current = data?.version || null;
                    const stored = localStorage.getItem(KEY);
                    if (current && stored && stored !== current) {
                        localStorage.setItem(KEY, current);
                        window.location.reload();
                    } else if (current && !stored) {
                        localStorage.setItem(KEY, current);
                    }
                } catch (error) {
                    console.error('Error checking version:', error);
                }
            }
            checkVersion();
            setInterval(checkVersion, 24 * 60 * 60 * 1000);
        })();
    </script>
    
