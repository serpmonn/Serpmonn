                }
            }
            {% if localesPromocodes[locale].promoCodes.faq3Question %},
            {
                "@type": "Question",
                "name": {{ localesPromocodes[locale].promoCodes.faq3Question | dump | safe }},
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ localesPromocodes[locale].promoCodes.faq3Answer | striptags | dump | safe }}
                }
            }
            {% endif %}
            {% if localesPromocodes[locale].promoCodes.faq4Question %},
            {
                "@type": "Question",
                "name": {{ localesPromocodes[locale].promoCodes.faq4Question | dump | safe }},
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ localesPromocodes[locale].promoCodes.faq4Answer | striptags | dump | safe }}
                }
            }
            {% endif %}
            {% if localesPromocodes[locale].promoCodes.faq5Question %},
            {
                "@type": "Question",
                "name": {{ localesPromocodes[locale].promoCodes.faq5Question | dump | safe }},
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ localesPromocodes[locale].promoCodes.faq5Answer | striptags | dump | safe }}
                }
            }
            {% endif %}
            {% if localesPromocodes[locale].promoCodes.faq6Question %},
            {
                "@type": "Question",
                "name": {{ localesPromocodes[locale].promoCodes.faq6Question | dump | safe }},
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ localesPromocodes[locale].promoCodes.faq6Answer | striptags | dump | safe }}
                }
            }
            {% endif %}
        ]
    }
    </script>

    {% if promocodesBuild.schemaOffers.length %}
    <script type="application/ld+json" id="promo-offers-schema">
    {
        "@context": "https://schema.org",
        "@graph": {{ promocodesBuild.schemaOffers | dump | safe }}
    }
    </script>
    {% endif %}

    <script id="promo-bootstrap" type="application/json">{{ {
        stats: promocodesBuild.stats,
        categories: promocodesBuild.categories,
        version: promocodesBuild.version
    } | dump | safe }}</script>

    <script src="/frontend/scripts/mobile-enhancements.js" defer></script>
    {% from "partials/mobile-anchor-ad.njk" import mobileAnchor %}
    {{ mobileAnchor(localesNews[locale].news.closeAd) }}
{% include "partials/ad-pool-init.njk" %}
</body>
</html>