---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{% if locale == 'ru' %}/frontend/games/redsquare2/score_table.html{% else %}/frontend/{{ locale }}/games/redsquare2/score_table.html{% endif %}"
eleventyComputed:
  title: "{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTablePageTitle | default(gameRedsquare2Translations[locale].gameRedsquare2.scoreTableTitle) }}"
  description: "{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableMetaDescription }}"
  dir: "{% if rtlLocales.indexOf(locale) != -1 %}rtl{% else %}ltr{% endif %}"
  canonical: "{% if locale == 'ru' %}{{ site.baseUrl }}/frontend/games/redsquare2/score_table.html{% else %}{{ site.baseUrl }}/frontend/{{ locale }}/games/redsquare2/score_table.html{% endif %}"
---

<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Language" content="{{ locale }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical }}"/>
  <link rel="icon" href="/frontend/images/serpmonn.ico?v=3" type="image/x-icon">
  <link rel="stylesheet" href="/frontend/styles/styles.css">
  <link rel="stylesheet" href="/frontend/styles/menu.css">
  <link rel="stylesheet" href="/frontend/styles/accessibility.css">
  <link rel="stylesheet" href="/frontend/games/redsquare2/redsquare2_styles/leaderboards.css?v=3">
  <script>
  window.lbI18n = {"loadFail":"{{ gameRedsquare2Translations[locale].gameRedsquare2.lbLoadFail | escape }}","empty":"{{ gameRedsquare2Translations[locale].gameRedsquare2.lbEmpty | escape }}"};
  </script>
  <script type="module" src="/frontend/scripts/menu-loader.js" defer></script>
  <script type="module" src="/frontend/games/redsquare2/redsquare2_scripts/leaderboard.js?v=4" defer></script>
  <script async src="https://ad.mail.ru/static/ads-async.js"></script>
</head>
<body class="leaderboard-page">
    <div class="ad-container leaderboard-top-ad">
        <ins class="mrg-tag" style="display:inline-block;width:320px;height:50px"
             data-ad-client="ad-{{ mailAds.slots.mobileAnchor.id }}" data-ad-slot="{{ mailAds.slots.mobileAnchor.id }}"></ins>
    </div>

    <h1 class="leaderboard-page-title">{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTablePageTitle | default(gameRedsquare2Translations[locale].gameRedsquare2.lbTitle) }}</h1>

    <div class="leaderboard-grid">
        <section class="leaderboard-board" id="redsquare2-board">
            <h2>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableBoardRedsquare2 }}</h2>
            <table>
                <thead>
                    <tr>
                        <th>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableColRank }}</th>
                        <th>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableColNickname }}</th>
                        <th>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableColScore }}</th>
                    </tr>
                </thead>
                <tbody id="leaderboardBodyRedsquare2"></tbody>
            </table>
        </section>

        <section class="leaderboard-board" id="neli-board">
            <h2>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableBoardNeli }}</h2>
            <table>
                <thead>
                    <tr>
                        <th>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableColRank }}</th>
                        <th>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableColNickname }}</th>
                        <th>{{ gameRedsquare2Translations[locale].gameRedsquare2.scoreTableColTime }}</th>
                    </tr>
                </thead>
                <tbody id="leaderboardBodyNeli"></tbody>
            </table>
        </section>
    </div>

    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <ins class="mrg-tag" style="display:inline-block;width:300px;height:250px"
             data-ad-client="ad-{{ mailAds.slots.top.id }}" data-ad-slot="{{ mailAds.slots.top.id }}"></ins>
    </div>
<script src="/frontend/scripts/mobile-enhancements.js" defer></script>
{% include "partials/ad-pool-init.njk" %}
</body>
</html>
