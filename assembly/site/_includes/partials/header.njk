<div class="news-block news-block--pending" id="news-block">
  <div class="news-block-header">
    <div class="news-dot"></div>
    <span class="news-block-title">{{ newsLabel }}</span>
  </div>

  <div id="news-hero-wrap" class="news-hero-wrap">
    <div class="news-skeleton" aria-hidden="true">
      <div class="news-skeleton__line news-skeleton__line--title"></div>
      <div class="news-skeleton__line"></div>
      <div class="news-skeleton__line news-skeleton__line--short"></div>
    </div>
  </div>

  <div class="feed-wrapper">
    <button class="feed-arrow feed-arrow-left" aria-label="{{ newsPrevLabel or 'Previous' }}" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="news-feed" id="news-feed"></div>
    <button class="feed-arrow feed-arrow-right" aria-label="{{ newsNextLabel or 'Next' }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</div>

{# Reserved height for letters canvas — avoids CLS when JS mounts it #}
<div id="serpmonn-letters-slot" class="serpmonn-letters-slot" aria-hidden="true"></div>
