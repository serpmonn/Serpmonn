{# Метрика после первой отрисовки — не конкурирует с LCP. #}
<script type="text/javascript">
  (function () {
    var METRIKA_ID = 98158791;
    var loaded = false;
    function loadMetrika() {
      if (loaded) return;
      loaded = true;
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) return;
        }
        k = e.createElement(t);
        a = e.getElementsByTagName(t)[0];
        k.async = 1;
        k.src = r;
        a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

      ym(METRIKA_ID, 'init', {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: true,
        ecommerce: 'dataLayer'
      });

      fetch('https://api.ipify.org?format=json')
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (typeof ym === 'undefined') return;
          ym(METRIKA_ID, 'params', { ip_address: data.ip, user_ip: data.ip });
          ym(METRIKA_ID, 'hit', window.location.href, {
            params: { ip_address: data.ip }
          });
        })
        .catch(function () {});
    }

    if (document.readyState === 'complete') {
      setTimeout(loadMetrika, 1);
    } else {
      window.addEventListener('load', function () {
        setTimeout(loadMetrika, 1);
      });
    }
  })();
</script>
