uploads/dm-audio/

# Firebase / Google Android client config — никогда не коммитить реальные ключи
google-services.json
google-services*.json
!google-services.json.example
!**/google-services.json.example

# Backend secrets (Firebase service accounts и прочие ключи) — только на сервере
backend/secrets/**
