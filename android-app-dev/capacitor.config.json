{
	"appId": "ru.serpmonn.dev",
	"appName": "Serpmonn Dev",
	"webDir": "www",
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#ffffff",
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"backgroundColor": "#ffffff",
			"showSpinner": false,
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#ffffff"
		},
		"PushNotifications": {
			"presentationOptions": ["badge", "sound", "alert"]
		}
	},
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"serpmonn.ru",
			"*.serpmonn.ru",
			"dev.serpmonn.ru",
			"id.vk.com",
			"id.vk.ru",
			"oauth.vk.com",
			"oauth.vk.ru",
			"login.vk.com",
			"login.vk.ru",
			"*.vk.com",
			"*.vk.ru"
		]
	}
}
